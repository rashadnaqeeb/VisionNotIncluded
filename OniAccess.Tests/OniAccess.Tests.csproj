<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The module (and, through it, the host). The module's assembly name is
         timestamped per build for hot reload; the tests pin it so the reference
         resolves. -->
    <ProjectReference Include="..\OniAccess.Module\OniAccess.Module.csproj" AdditionalProperties="OniModuleName=OniAccess.Module" />
    <!-- The dev server's REPL compiler, exercised by the evaluator tests. -->
    <Reference Include="Mono.CSharp">
      <HintPath>$(MSBuildProjectDirectory)\..\vendor\Mono.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Game DLL references for type resolution (KButtonEvent, etc.) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ONI_MANAGED)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ONI_MANAGED)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ONI_MANAGED)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
