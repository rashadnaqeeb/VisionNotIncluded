<Project Sdk="Microsoft.NET.Sdk">

  <!-- HOST/MODULE SPLIT (hot reload). This project builds the permanent HOST
       (OniAccess.dll): the entry point, native preload, dev-server core, and the
       module loader. Everything else compiles into the byte-loaded MODULE
       (OniAccess.Module/OniAccess.Module.csproj, which references this project),
       hot-swapped at runtime via POST /reload. Host changes need a game restart;
       keep the compile list below minimal. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OniAccess</AssemblyName>
    <RootNamespace>OniAccess</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.7.6</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Mod.cs" />
    <Compile Include="Modularity\**\*.cs" />
    <Compile Include="Util\LogHelper.cs" />
    <Compile Include="Util\LogUnityBackend.cs" />
    <Compile Include="Dev\DevServer.cs" />
    <Compile Include="Dev\DevHttpServer.cs" />
    <Compile Include="Dev\CSharpEvaluator.cs" />
    <Compile Include="Dev\SpeechLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game DLL references via ONI_MANAGED environment variable -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ONI_MANAGED)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ONI_MANAGED)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ONI_MANAGED)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ONI_MANAGED)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ONI_MANAGED)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The DEBUG-only dev server: Mono.CSharp (the /eval REPL compiler, vendored;
       build.sh deploys it to the mod root, where the game's loader probes for the
       host's dependencies) and ScreenCapture for /screenshot. All dev code is
       #if DEBUG, so a Release build neither compiles against nor ships these. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Reference Include="Mono.CSharp">
      <HintPath>$(MSBuildProjectDirectory)\..\vendor\Mono.CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(ONI_MANAGED)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
